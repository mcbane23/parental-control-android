rules_version = '2';

// Security rules for accounts, families and pairing.
// Paste these into the Firebase console (Firestore Database > Rules) or deploy
// them with the Firebase CLI. See docs/firebase-setup.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isGoogleUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }
    function memberPath(fid, uid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(uid);
    }
    function codePath(code) {
      return /databases/$(database)/documents/pairingCodes/$(code);
    }
    function isMember(fid) {
      return signedIn() && exists(memberPath(fid, request.auth.uid));
    }
    function isOwner(fid) {
      return signedIn() && get(familyPath(fid)).data.ownerUid == request.auth.uid;
    }
    // Parents with full control can add devices and invite parents.
    function isManager(fid) {
      return isMember(fid)
        && get(memberPath(fid, request.auth.uid)).data.role == 'parent'
        && get(memberPath(fid, request.auth.uid)).data.fullControl == true;
    }

    // Which family and role an account has. Written once, when joining.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && existsAfter(memberPath(request.resource.data.familyId, uid))
        && getAfter(memberPath(request.resource.data.familyId, uid)).data.role == request.resource.data.role;
    }

    match /families/{fid} {
      allow get: if isMember(fid);
      allow create: if isGoogleUser() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(fid) && request.resource.data.ownerUid == resource.data.ownerUid;

      match /members/{uid} {
        allow read: if isMember(fid);

        // Either the owner adding themselves while creating the family,
        // or someone joining with a valid, unexpired pairing code.
        allow create: if signedIn() && request.auth.uid == uid && (
          (
            isGoogleUser()
            && getAfter(familyPath(fid)).data.ownerUid == uid
            && request.resource.data.role == 'parent'
            && request.resource.data.owner == true
          ) || (
            request.resource.data.owner == false
            && request.resource.data.fullControl == false
            && request.resource.data.role in ['parent', 'child']
            && (request.resource.data.role == 'child' || isGoogleUser())
            && request.resource.data.code is string
            && exists(codePath(request.resource.data.code))
            && get(codePath(request.resource.data.code)).data.familyId == fid
            && get(codePath(request.resource.data.code)).data.role == request.resource.data.role
            && get(codePath(request.resource.data.code)).data.expiresAt > request.time
          )
        );

        // Only the main parent can grant or remove full control, and never on themselves.
        allow update: if isOwner(fid) && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullControl', 'name']);
        allow delete: if isOwner(fid) && uid != request.auth.uid;
      }
    }

    // Short-lived codes. Anyone signed in can look one up by its exact value, nobody can list them.
    match /pairingCodes/{code} {
      allow get: if signedIn();
      allow create: if isManager(request.resource.data.familyId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.role in ['parent', 'child']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(20, 'm');
      allow delete: if isMember(resource.data.familyId);
    }
  }
}
